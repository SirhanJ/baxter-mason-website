{
  "name": "vexur-baxter-mason-property-buyers-agent-import",
  "main": "cloudflare/worker.mjs",
  "account_id": "803a6110a08870666ff96e550c856254",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vexur-baxter-mason-property-buyers-agent-import",
      "environment": "production"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "vexur-opennext-inc-cache"
    }
  ],
  "vars": {
    "NEXT_INC_CACHE_R2_PREFIX": "vexur-baxter-mason-property-buyers-agent-import/seo-20261104"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
